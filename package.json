{
  "name": "discount-deploy-mc-app",
  "version": "1.0.0",
  "description": "Merchant Center Custom Application that deploys discounts from a stage commercetools project to a production one.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "mc-scripts start",
    "build": "mc-scripts build",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "npm run compile-html:local && mc-scripts serve",
    "service": "node service/server.mjs",
    "cli": "node service/bin/cli.mjs",
    "test": "node --test service/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx}'",
    "predeploy": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:harness": "esbuild test/ui/harness.tsx --bundle --outfile=test/ui/harness.js --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"development\"'",
    "test:ui": "npm run build:harness && playwright test test/ui"
  },
  "dependencies": {
    "@commercetools-backend/express": "^27.12.0",
    "@commercetools-frontend/actions-global": "^27.7.0",
    "@commercetools-frontend/application-components": "^27.7.0",
    "@commercetools-frontend/application-config": "^27.7.0",
    "@commercetools-frontend/application-shell": "^27.7.0",
    "@commercetools-frontend/application-shell-connectors": "^27.7.0",
    "@commercetools-frontend/assets": "^27.7.0",
    "@commercetools-frontend/babel-preset-mc-app": "^27.7.0",
    "@commercetools-frontend/constants": "^27.7.0",
    "@commercetools-frontend/i18n": "^27.7.0",
    "@commercetools-frontend/mc-dev-authentication": "^27.7.0",
    "@commercetools-frontend/mc-scripts": "^27.7.0",
    "@commercetools-frontend/permissions": "^27.7.0",
    "@commercetools-uikit/card": "^20.4.0",
    "@commercetools-uikit/checkbox-input": "^20.4.0",
    "@commercetools-uikit/constraints": "^20.4.0",
    "@commercetools-uikit/data-table": "^20.4.0",
    "@commercetools-uikit/icons": "^20.4.0",
    "@commercetools-uikit/link": "^20.4.0",
    "@commercetools-uikit/loading-spinner": "^20.4.0",
    "@commercetools-uikit/primary-button": "^20.4.0",
    "@commercetools-uikit/secondary-button": "^20.4.0",
    "@commercetools-uikit/spacings": "^20.4.0",
    "@commercetools-uikit/tag": "^20.4.0",
    "@commercetools-uikit/text": "^20.4.0",
    "@commercetools/http-user-agent": "^4.0.1",
    "@emotion/react": "^11.14.0",
    "graphql": "16.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-intl": "^7.1.4",
    "react-redux": "9.2.0",
    "react-router-dom": "5.3.4",
    "redux": "5.0.1",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@commercetools-frontend/eslint-config-mc-app": "^27.7.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^9.0.0",
    "prettier": "2.8.8"
  }
}
