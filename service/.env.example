# discount-deploy service — credentials for BOTH commercetools projects.
#
# Copy to service/.env for local development. Deployed, these are the Netlify
# site's environment variables instead; nothing here is ever sent to the browser.

# ---- SOURCE: the project discounts are authored in. Read only. ----
STAGE_CTP_PROJECT_KEY=
STAGE_CTP_CLIENT_ID=
STAGE_CTP_CLIENT_SECRET=
STAGE_CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
STAGE_CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# ---- TARGET: the project discounts are deployed to. Written. ----
# Grant this client exactly: manage_cart_discounts, manage_product_discounts,
# manage_discount_codes, plus view_products, view_categories,
# view_customer_groups, view_stores, view_states, view_tax_categories for the
# reference lookups a predicate rewrite needs. See docs/setup.md.
PROD_CTP_PROJECT_KEY=
PROD_CTP_CLIENT_ID=
PROD_CTP_CLIENT_SECRET=
PROD_CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
PROD_CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# ---- the deployed function's session verification ----
# APP_AUDIENCE is this deployment's public origin, and must match `apiBase` in
# custom-application-config.mjs. The Merchant Center API Gateway signs each
# forwarded request with this as the token audience; the function refuses to
# serve without it.
APP_AUDIENCE=https://your-site.netlify.app
# The Merchant Center cloud the app is registered in — must match
# `cloudIdentifier` in custom-application-config.mjs.
# gcp-us | gcp-eu | gcp-au | aws-eu | aws-us | aws-fra | aws-ohio
APP_CLOUD_IDENTIFIER=gcp-us

# There is deliberately no shared API token. `npm run service` is an
# unauthenticated localhost server for development; the deployed function
# authenticates every request against the Merchant Center session instead.
